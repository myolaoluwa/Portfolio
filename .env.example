# Confirmed production origin. Hosted staging builds should use their own origin.
SITE_URL=https://delightech.net
# Set false on hosted previews; true for the approved production build.
SITE_INDEXING_ENABLED=true

# Optional analytics: blank keeps collection and consent controls disabled.
# Configure an Umami-compatible collector and website UUID, then rebuild.
# These are public values. Never put API secrets in NEXT_PUBLIC variables.
NEXT_PUBLIC_ANALYTICS_COLLECT_URL=
NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=

# Public email for privacy enquiries. Leave blank until approved.
PRIVACY_CONTACT_EMAIL=
